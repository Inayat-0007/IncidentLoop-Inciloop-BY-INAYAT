# Copy to `.env` locally. Never commit `.env`.
# Dummy placeholders only — no real secrets.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# Mutating routes (rollback). Generate a local random string.
ROLLBACK_TOKEN=replace_me_with_a_local_token

# Telemetry source for live API. files = exported JSON (default). sim = pytest/CI only.
DATA_SOURCE=files
# Optional HTTP JSON (DATA_SOURCE=http). GET only. Never invent metrics if these fail.
METRICS_URL=
LOGS_URL=
RELEASES_URL=
# Optional GitHub releases/tags (DATA_SOURCE=github). Metrics/logs still come from data/company files.
GITHUB_REPO=
GITHUB_TOKEN=
# Optional CD hook. POST {from,to,incident_id} with Authorization: Bearer $ROLLBACK_TOKEN after the policy gate.
ROLLBACK_WEBHOOK_URL=

# LLM — live path requires Gemini. Heuristic is TEST/CI only (DEVOPSPILOT_FORCE_HEURISTIC=1).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=20
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Local paths
DATA_DIR=./data
CHROMA_PATH=./data/chroma
# COMPANY_DATA_DIR=./data/company

# Force heuristic even if keys exist — **pytest/CI only**. Default 0 for Docker and local API.
DEVOPSPILOT_FORCE_HEURISTIC=0

# MCP (optional OS env — .cursor/mcp.json uses ${env:NAME} only)
# GITLAB_TOKEN=
