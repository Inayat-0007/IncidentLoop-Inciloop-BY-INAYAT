# Copy to `.env` locally. Never commit `.env`.
# Dummy placeholders only — no real secrets.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# Mutating routes (rollback). Generate a local random string.
ROLLBACK_TOKEN=replace_me_with_a_local_token

# LLM — optional. If unset, heuristic fallback is used (required for tests/Docker).
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Local paths
DATA_DIR=./data
CHROMA_PATH=./data/chroma

# Force heuristic even if keys exist (CI)
DEVOPSPILOT_FORCE_HEURISTIC=0

# MCP (optional OS env — .cursor/mcp.json uses ${env:NAME} only)
# GITHUB_TOKEN=
# GITLAB_TOKEN=
