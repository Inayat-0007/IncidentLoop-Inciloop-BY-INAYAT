{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inciloop.dev/schemas/error.json",
  "title": "Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "enum": ["UNAUTHENTICATED", "FORBIDDEN", "NOT_FOUND", "VALIDATION_ERROR", "INTERNAL"]
    },
    "message": { "type": "string" }
  }
}
